# ===========================================
# Team Connect Backend - Environment Variables
# ===========================================
# Copy this file to .env and update values

# -------------------------------------------
# Server Configuration
# -------------------------------------------
PORT=3000
NODE_ENV=development

# -------------------------------------------
# Database Configuration
# -------------------------------------------
DATABASE_URL="postgresql://teamconnect:your_password@localhost:5432/teamconnect?schema=public"

# -------------------------------------------
# JWT Configuration
# -------------------------------------------
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# -------------------------------------------
# LiveKit Configuration
# -------------------------------------------
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=ws://localhost:7880

# -------------------------------------------
# Ngrok Configuration (for public sharing)
# -------------------------------------------
# Your ngrok domain (without https://)
NGROK_DOMAIN=your-ngrok-url.ngrok-free.dev

# Full ngrok URL
NGROK_URL=https://your-ngrok-url.ngrok-free.dev

# -------------------------------------------
# CORS Configuration
# -------------------------------------------
# Comma-separated list of allowed origins
# Include localhost URLs and your ngrok URL
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,https://your-ngrok-url.ngrok-free.dev"

# -------------------------------------------
# Redis Configuration (optional)
# -------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# -------------------------------------------
# Storage Configuration
# -------------------------------------------
STORAGE_PROVIDER=local
STORAGE_PATH=./uploads

# Cloudinary (if STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -------------------------------------------
# Logging
# -------------------------------------------
LOG_LEVEL=debug
LOG_DIR=./logs

# -------------------------------------------
# Rate Limiting
# -------------------------------------------
RATE_LIMIT_MAX_REQUESTS=3000
RATE_LIMIT_WINDOW_MS=900000

# -------------------------------------------
# Request Timeout (ms)
# -------------------------------------------
REQUEST_TIMEOUT=30000

# -------------------------------------------
# Meeting Chat Retention (days)
# -------------------------------------------
MEETING_CHAT_RETENTION_DAYS=14

# -------------------------------------------
# Optional Features
# -------------------------------------------
ENABLE_SWAGGER=true

# -------------------------------------------
# SMTP Email Configuration
# -------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Frontend URL for email links
FRONTEND_URL=http://localhost:5173

# App Name for emails
APP_NAME=Team Connect
