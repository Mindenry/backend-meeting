generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id              String   @id @default(uuid())
  name            String
  domain          String?  // Allowed email domain (e.g., "company.com")
  allowedDomains  String[] @default([]) // Multiple allowed domains
  settings        Json?    // Organization settings
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users    User[]
  teams    Team[]
  invites  Invite[]
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  name        String
  password    String?  // Hashed password (nullable for invited users)
  role        String   @default("employee") // org_owner, admin, manager, employee
  status      String   @default("online")   // online, busy, away, offline
  currentRoom String?                        // virtual office room ID
  activity    String   @default("Available")
  avatar      String?  // Avatar URL
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  teams              TeamMember[]
  meetings           Meeting[] @relation("HostedMeetings")
  meetingParticipants MeetingParticipant[]
  tasks              Task[]    @relation("UserTasks")
  messages           Message[] @relation("SentMessages")
  notifications      Notification[]
  taskComments       TaskComment[]
  messageReads       MessageRead[]
  auditLogs          AuditLog[]
  taskActivityLogs   TaskActivityLog[]
}

model Team {
  id        String       @id @default(uuid())
  name      String
  description String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  members   TeamMember[]
  meetings  Meeting[]
  tasks     Task[]
  channels  Channel[]
}

model TeamMember {
  id        String   @id @default(uuid())
  role      String   @default("member")
  createdAt DateTime @default(now())

  userId String
  teamId String

  user   User @relation(fields: [userId], references: [id])
  team   Team @relation(fields: [teamId], references: [id])

  @@unique([userId, teamId])
}

model Meeting {
  id              String   @id @default(uuid())
  title           String
  description     String?
  startTime       DateTime
  endTime         DateTime?
  meetingCode     String   @unique // Unique meeting code/ID
  password        String?  // Meeting password (hashed or plain)
  waitingRoom     Boolean  @default(true)
  allowScreenShare Boolean @default(true)
  isLocked        Boolean  @default(false)
  status          String   @default("scheduled") // scheduled, live, ended
  actualStartTime DateTime?
  actualEndTime   DateTime?
  summary         String?  // Post-meeting summary
  recordingUrl    String?  // URL to recording file
  aiSummary       String?  // AI generated summary
  transcript      String?  // Meeting transcript
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  teamId String?
  hostId String

  team   Team? @relation(fields: [teamId], references: [id])
  host   User  @relation("HostedMeetings", fields: [hostId], references: [id])
  tasks  Task[]
  participants MeetingParticipant[]
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  priority    String   @default("medium") // low, medium, high, urgent
  status      String   @default("todo") // todo, in_progress, review, done
  dueDate     DateTime?
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assigneeId String?
  teamId     String?
  meetingId  String?

  assignee   User?    @relation("UserTasks", fields: [assigneeId], references: [id])
  team       Team?    @relation(fields: [teamId], references: [id])
  meeting    Meeting? @relation(fields: [meetingId], references: [id])
  comments   TaskComment[]
  activityLog TaskActivityLog[]
}

model Channel {
  id          String   @id @default(uuid())
  name        String
  type        String   @default("general") // general, announcement, voice
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teamId String
  team   Team   @relation(fields: [teamId], references: [id])

  messages Message[]

  @@unique([teamId, name])
}

model Message {
  id        String   @id @default(uuid())
  text      String
  isPinned  Boolean  @default(false)
  isSystem  Boolean  @default(false)
  attachments Json?  // Array of { url: string, name: string, type: string }
  mentions   String[] @default([]) // Array of user IDs mentioned
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channelId String
  senderId   String
  replyToId  String?

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender   User   @relation("SentMessages", fields: [senderId], references: [id])
  replyTo  Message? @relation("Replies", fields: [replyToId], references: [id])
  replies  Message[] @relation("Replies")
  reads    MessageRead[]
}

// New models for additional features

model Invite {
  id          String   @id @default(uuid())
  email       String
  token       String   @unique
  role        String   @default("employee")
  teamId      String?  // Optional initial team
  invitedBy   String   // User ID who sent the invite
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([token])
  @@index([email])
}

model MeetingParticipant {
  id          String   @id @default(uuid())
  joinedAt    DateTime @default(now())
  leftAt      DateTime?
  handRaised  Boolean  @default(false)
  isMuted     Boolean  @default(false)
  isVideoOn   Boolean  @default(false)
  isSharing   Boolean  @default(false)
  waitingRoom Boolean  @default(true) // true if in waiting room, false if admitted

  meetingId String
  userId    String

  meeting Meeting @relation(fields: [meetingId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([meetingId, userId])
  @@index([meetingId])
}

model Notification {
  id        String   @id @default(uuid())
  type      String   // mention, task_assigned, meeting_starting, announcement, etc.
  title     String
  message   String
  link      String?  // URL to related resource
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
}

model TaskComment {
  id        String   @id @default(uuid())
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id])
  user User @relation(fields: [userId], references: [id])
}

model TaskActivityLog {
  id        String   @id @default(uuid())
  action    String   // created, status_changed, assigned, due_date_changed, etc.
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  taskId String
  userId String? // User who performed the action

  task Task @relation(fields: [taskId], references: [id])
  user User? @relation(fields: [userId], references: [id])
}

model MessageRead {
  id        String   @id @default(uuid())
  readAt    DateTime @default(now())

  messageId String
  userId    String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([messageId, userId])
  @@index([userId, messageId])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String   // create_user, delete_team, update_permission, etc.
  resource  String   // user, team, meeting, etc.
  resourceId String?
  details   Json?    // Additional details
  ipAddress String?
  createdAt DateTime @default(now())

  userId String?
  user   User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([resource, resourceId])
  @@index([createdAt])
}


