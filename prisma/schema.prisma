generator client {
  provider = "prisma-client-js"
}

generator dbml {
  provider = "prisma-dbml-generator"
  output   = "../../tmp-dbml/dbml"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id             String   @id @default(uuid())
  name           String
  domain         String? // Allowed email domain (e.g., "company.com")
  allowedDomains String[] @default([]) // Multiple allowed domains
  logo           String? // Organization logo URL
  settings       Json? // Organization settings
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users           User[]
  teams           Team[]
  invites         Invite[]
  holidays        Holiday[]
  rolePermissions RolePermission[]
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  name        String
  displayName String?  // Optional display name fallback
  password    String? // Hashed password (nullable for invited users)
  role        String   @default("employee") // org_owner, admin, manager, employee
  status      String   @default("offline") // online, busy, away, offline
  currentRoom String? // virtual office room ID
  activity    String   @default("Available")
  avatar      String? // Avatar URL
  isActive    Boolean  @default(true)
  department  String?  // Optional department
  position    String?  // Optional job title
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  
  managerId     String?
  manager       User?    @relation("UserManager", fields: [managerId], references: [id])
  directReports User[]   @relation("UserManager")

  teams                   TeamMember[]
  meetings                Meeting[]               @relation("HostedMeetings")
  meetingParticipants     MeetingParticipant[]
  tasks                   Task[]                  @relation("UserTasks")
  reportedTasks           Task[]                  @relation("ReporterTasks")
  taskWatchers            TaskWatcher[]
  messages                Message[]               @relation("SentMessages")
  notifications           Notification[]          @relation("UserNotifications")
  taskComments            TaskComment[]
  messageReads            MessageRead[]
  auditLogs               AuditLog[]
  taskActivityLogs        TaskActivityLog[]
  driveEntries            DriveEntry[]
  driveFileVersions       DriveFileVersion[]
  drivePermissions        DrivePermission[]
  workHours               WorkHours[]
  timeEntries             TimeEntry[]
  createdSprints          Sprint[]                @relation("SprintCreator")
  createdEpics            Epic[]                  @relation("EpicCreator")
  taskAttachments         TaskAttachment[]
  taskTemplates           TaskTemplate[]
  refreshTokens           RefreshToken[]
  reactions               MessageReaction[]
  createdDocuments        Document[]              @relation("CreatedDocuments")
  documentPermissions     DocumentPermission[]
  createdVersions         DocumentVersion[]       @relation("CreatedVersions")
  createdFolders          DocumentFolder[]        @relation("CreatedFolders")
  createdReminders        Reminder[]              @relation("CreatedReminders")
  reminderRecipients      ReminderRecipient[]
  workflows               Workflow[]              @relation("WorkflowCreator")
  workflowRuns            WorkflowRun[]
  createdMinutes          MeetingMinutes[]        @relation("MinutesCreator")
  notificationPreferences NotificationPreference? @relation("NotificationPreferences")
  notificationDigests     NotificationDigest[]    @relation("NotificationDigests")
  // New features
  wikiArticles            WikiArticle[]           @relation("WikiCreator")
  wikiVersions            WikiArticleVersion[]    @relation("WikiVersionCreator")
  wikiComments            WikiComment[]           @relation("WikiCommentCreator")
  createdAnnouncements    Announcement[]          @relation("AnnouncementCreator")
  announcementReads       AnnouncementRead[]      @relation("AnnouncementReads")
  // Direct messages
  sentDirectMessages      DirectMessage[]         @relation("SentDirectMessages")
  receivedDirectMessages  DirectMessage[]         @relation("ReceivedDirectMessages")
}

model Team {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  members         TeamMember[]
  meetings        Meeting[]
  tasks           Task[]
  channels        Channel[]
  driveEntries    DriveEntry[]
  workHours       WorkHours[]
  sprints         Sprint[]
  epics           Epic[]
  projects        Project[]
  components      Component[]
  versions        Version[]
  documents       Document[]
  documentFolders DocumentFolder[]
  workflows       Workflow[]
  workflowStatuses TaskWorkflowStatus[]
  // New features
  wikiArticles    WikiArticle[]
}

model TeamMember {
  id        String   @id @default(uuid())
  role      String   @default("member")
  createdAt DateTime @default(now())

  userId String
  teamId String

  user User @relation(fields: [userId], references: [id])
  team Team @relation(fields: [teamId], references: [id])

  @@unique([userId, teamId])
  @@index([userId])
  @@index([teamId])
}

model Meeting {
  id               String    @id @default(uuid())
  title            String
  description      String?
  startTime        DateTime
  endTime          DateTime?
  meetingCode      String    @unique // Unique meeting code/ID
  isInstant        Boolean   @default(false) // Is this an instant meeting
  allowScreenShare Boolean   @default(true)
  status           String    @default("scheduled") // scheduled, live, ended
  actualStartTime  DateTime?
  actualEndTime    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Recurring meeting fields
  isRecurring         Boolean   @default(false)
  recurringPattern    String? // daily, weekly, monthly, yearly
  recurringDays       Int[]     @default([]) // For weekly: [1,3,5] = Mon, Wed, Fri (0=Sunday, 1=Monday, etc.)
  recurringEndDate    DateTime? // When to stop recurring
  recurringTemplateId String? // Reference to the template if this is an instance
  parentMeetingId     String? // If this is an instance, reference to template
  parentMeeting       Meeting?  @relation("RecurringInstances", fields: [parentMeetingId], references: [id])
  childMeetings       Meeting[] @relation("RecurringInstances")

  teamId String?
  hostId String

  team         Team?                @relation(fields: [teamId], references: [id])
  host         User                 @relation("HostedMeetings", fields: [hostId], references: [id])
  tasks        Task[]
  recordings   MeetingRecording[]
  participants MeetingParticipant[]
  reminders    MeetingReminder[]
  minutes      MeetingMinutes[]

  @@index([hostId, startTime])
  @@index([teamId, startTime])
  @@index([status, startTime])
  @@index([startTime])
}

model Task {
  id          String    @id @default(uuid())
  title       String
  description String?
  priority    String    @default("medium") // low, medium, high, urgent
  status      String    @default("todo") // todo, in_progress, review, done
  issueType   String    @default("task") // task, bug, story, epic, subtask
  resolution  String? // done, wont_fix, duplicate, cancelled
  dueDate     DateTime?
  tags        String[]
  storyPoints Int? // Story points for estimation (e.g., 1, 2, 3, 5, 8, 13)
  estimate    Float? // Estimated hours
  isRecurring Boolean   @default(false)
  recurringPattern String? // daily, weekly, monthly
  recurringInterval Int?    @default(1)
  recurringEndDate DateTime?
  templateId  String?
  position    Int       @default(0) // Position in kanban column for sorting
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  assigneeId String?
  reporterId String? // User who created/reported the task
  teamId     String?
  meetingId  String?
  sprintId   String?
  epicId     String?
  projectId  String?
  componentId  String?
  versionId    String?
  parentTaskId String?

  assignee    User?             @relation("UserTasks", fields: [assigneeId], references: [id])
  reporter    User?             @relation("ReporterTasks", fields: [reporterId], references: [id])
  team        Team?             @relation(fields: [teamId], references: [id])
  meeting     Meeting?          @relation(fields: [meetingId], references: [id])
  sprint      Sprint?           @relation(fields: [sprintId], references: [id])
  epic        Epic?             @relation(fields: [epicId], references: [id])
  project     Project?          @relation(fields: [projectId], references: [id])
  component   Component?        @relation(fields: [componentId], references: [id])
  version     Version?          @relation(fields: [versionId], references: [id])
  parentTask  Task?             @relation("SubTasks", fields: [parentTaskId], references: [id])
  childTasks  Task[]            @relation("SubTasks")
  comments    TaskComment[]
  activityLog TaskActivityLog[]
  subtasks    Subtask[]
  timeEntries TimeEntry[]
  attachments TaskAttachment[]
  watchers    TaskWatcher[]
  linkedIssues IssueLink[]      @relation("SourceTask")
  linkedFrom  IssueLink[]       @relation("TargetTask")

  @@index([assigneeId, status])
  @@index([teamId, status])
  @@index([status, updatedAt])
  @@index([dueDate])
  @@index([sprintId])
  @@index([epicId])
  @@index([projectId])
  @@index([componentId])
  @@index([versionId])
  @@index([issueType])
  @@index([parentTaskId])
}

model Channel {
  id          String   @id @default(uuid())
  name        String
  type        String   @default("general") // general, announcement, voice
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teamId String
  team   Team   @relation(fields: [teamId], references: [id])

  messages Message[]
  threads  Thread[]

  @@unique([teamId, name])
}

model Message {
  id          String   @id @default(uuid())
  text        String
  isPinned    Boolean  @default(false)
  isSystem    Boolean  @default(false)
  attachments Json? // Array of { url: string, name: string, type: string }
  mentions    String[] @default([]) // Array of user IDs mentioned
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  channelId String
  senderId  String
  replyToId String?
  threadId  String? // For thread replies

  channel       Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender        User          @relation("SentMessages", fields: [senderId], references: [id])
  replyTo       Message?      @relation("Replies", fields: [replyToId], references: [id])
  replies       Message[]     @relation("Replies")
  reads         MessageRead[]
  thread        Thread?       @relation("ThreadReplies", fields: [threadId], references: [id])
  threadMessage Thread?       @relation("ThreadMessage")

  reactions MessageReaction[]

  @@index([channelId, createdAt])
  @@index([senderId, createdAt])
}

/// Direct one-to-one messages between users (DM)
model DirectMessage {
  id          String   @id @default(uuid())
  text        String
  isPinned    Boolean  @default(false)
  isSystem    Boolean  @default(false)
  attachments Json?
  mentions    String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  senderId   String
  receiverId String

  sender   User @relation("SentDirectMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceivedDirectMessages", fields: [receiverId], references: [id])

  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, senderId, createdAt])
}

// New models for additional features

model Invite {
  id        String    @id @default(uuid())
  email     String
  token     String    @unique
  role      String    @default("employee")
  teamId    String? // Optional initial team
  teamRole  String? // Optional initial role in the team
  invitedBy String // User ID who sent the invite
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([token])
  @@index([email])
}

model TaskComment {
  id        String   @id @default(uuid())
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id])
  user User @relation(fields: [userId], references: [id])
}

model TaskActivityLog {
  id        String   @id @default(uuid())
  action    String // created, status_changed, assigned, due_date_changed, etc.
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  taskId String
  userId String? // User who performed the action

  task Task  @relation(fields: [taskId], references: [id])
  user User? @relation(fields: [userId], references: [id])
}

model MessageRead {
  id     String   @id @default(uuid())
  readAt DateTime @default(now())

  messageId String
  userId    String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([messageId, userId])
  @@index([userId, messageId])
}

model MessageReaction {
  id        String   @id @default(uuid())
  emoji     String // e.g., "👍", "❤️", "😂"
  messageId String
  userId    String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model Thread {
  id        String   @id @default(uuid())
  messageId String   @unique // The original message that started the thread
  channelId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channel Channel   @relation(fields: [channelId], references: [id])
  message Message   @relation("ThreadMessage", fields: [messageId], references: [id])
  replies Message[] @relation("ThreadReplies") // Thread replies

  @@index([channelId])
}

model Notification {
  id        String   @id @default(uuid())
  type      String // task_assigned, meeting_created, message_mention, etc.
  title     String
  message   String
  link      String? // URL to related resource
  read      Boolean  @default(false)
  priority  String   @default("normal") // urgent, high, normal, low
  groupedId String? // For grouping related notifications
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation("UserNotifications", fields: [userId], references: [id])

  relatedId   String? // ID of related entity (task, meeting, message, etc.)
  relatedType String? // task, meeting, message, etc.

  @@index([userId, read])
  @@index([userId, priority, read])
  @@index([groupedId])
  @@index([type, createdAt])
}

// Notification Preferences - ตั้งค่า notification delivery สำหรับแต่ละ user
model NotificationPreference {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation("NotificationPreferences", fields: [userId], references: [id], onDelete: Cascade)

  // Delivery mode per notification type
  // realtime: ส่งทันที
  // digest_hourly: สรุปทุกชั่วโมง
  // digest_daily: สรุปทุกวัน
  // digest_weekly: สรุปทุกสัปดาห์
  // off: ปิดการแจ้งเตือน

  // High priority notifications (always realtime)
  mentionDelivery           String @default("realtime") // realtime, digest_hourly, digest_daily, off
  taskAssignedDelivery      String @default("realtime") // realtime, digest_hourly, digest_daily, off
  meetingStartingDelivery   String @default("realtime") // realtime, digest_hourly, digest_daily, off
  pullRequestReviewDelivery String @default("realtime") // realtime, digest_hourly, digest_daily, off

  // Medium priority notifications
  taskUpdateDelivery     String @default("digest_hourly") // realtime, digest_hourly, digest_daily, off
  meetingCreatedDelivery String @default("digest_hourly") // realtime, digest_hourly, digest_daily, off
  messageDelivery        String @default("digest_hourly") // realtime, digest_hourly, digest_daily, off

  // Low priority notifications
  announcementDelivery String @default("digest_daily") // realtime, digest_hourly, digest_daily, off
  teamUpdateDelivery   String @default("digest_daily") // realtime, digest_hourly, digest_daily, off

  // Digest settings
  digestTime        String  @default("18:00") // Time to send daily digest (HH:mm format)
  digestTimezone    String  @default("Asia/Bangkok") // Timezone for digest time
  digestIncludeRead Boolean @default(false) // Include read notifications in digest

  // UI preferences
  soundEnabled   Boolean @default(true)
  desktopEnabled Boolean @default(true)
  badgeEnabled   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Notification Digest - สรุป notifications ที่ส่งเป็น digest
model NotificationDigest {
  id     String @id @default(uuid())
  userId String
  user   User   @relation("NotificationDigests", fields: [userId], references: [id], onDelete: Cascade)

  digestType  String // hourly, daily, weekly
  periodStart DateTime // Start of digest period
  periodEnd   DateTime // End of digest period

  // Summary data
  totalCount      Int      @default(0)
  unreadCount     Int      @default(0)
  byType          Json // { "mention": 5, "task_assigned": 3, ... }
  highlights      Json // Array of important notifications
  notificationIds String[] // IDs of notifications included in digest

  sentAt DateTime? // When digest was sent
  readAt DateTime? // When user read the digest
  isRead Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, digestType, periodStart])
  @@index([userId, isRead])
  @@index([sentAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String // create, update, delete
  entity    String // user, team, meeting, task, channel, message
  entityId  String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  userName  String?
  details   Json? // Additional details about the action
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// Document Management System
model DocumentFolder {
  id          String   @id @default(uuid())
  name        String
  description String?
  parentId    String? // For nested folders
  teamId      String?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team      Team?            @relation(fields: [teamId], references: [id])
  creator   User             @relation("CreatedFolders", fields: [createdBy], references: [id])
  parent    DocumentFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id])
  children  DocumentFolder[] @relation("FolderHierarchy")
  documents Document[]

  @@index([teamId])
  @@index([parentId])
}

model Document {
  id          String   @id @default(uuid())
  name        String
  description String?
  fileUrl     String
  fileSize    Int // in bytes
  mimeType    String
  folderId    String?
  teamId      String?
  createdBy   String
  version     Int      @default(1)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team        Team?                @relation(fields: [teamId], references: [id])
  folder      DocumentFolder?      @relation(fields: [folderId], references: [id])
  creator     User                 @relation("CreatedDocuments", fields: [createdBy], references: [id])
  versions    DocumentVersion[]
  permissions DocumentPermission[]

  @@index([teamId])
  @@index([folderId])
  @@index([createdBy])
  @@index([isArchived])
}

model DocumentVersion {
  id         String   @id @default(uuid())
  documentId String
  version    Int
  fileUrl    String
  fileSize   Int
  mimeType   String
  changeNote String?
  createdBy  String
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  creator  User     @relation("CreatedVersions", fields: [createdBy], references: [id])

  @@unique([documentId, version])
  @@index([documentId])
}

model DocumentPermission {
  id         String   @id @default(uuid())
  documentId String
  userId     String
  permission String   @default("view") // view, edit, delete
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId])
  @@index([documentId])
  @@index([userId])
}

// Meeting Recording & Minutes
model MeetingRecording {
  id            String   @id @default(uuid())
  meetingId     String
  fileUrl       String
  fileSize      Int // in bytes
  duration      Int // in seconds
  status        String   @default("processing") // processing, completed, failed
  driveEntryId  String? // Link to Shared Drive entry
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  meeting   Meeting     @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  driveEntry DriveEntry? @relation(fields: [driveEntryId], references: [id], onDelete: SetNull)

  @@index([meetingId])
  @@index([status])
  @@index([driveEntryId])
}

model MeetingMinutes {
  id          String   @id @default(uuid())
  meetingId   String
  title       String
  content     String // Markdown content
  actionItems Json? // Array of action items
  decisions   Json? // Array of decisions made
  attendees   String[] // User IDs of attendees
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  creator User   @relation("MinutesCreator", fields: [createdBy], references: [id])

  @@index([meetingId])
  @@index([createdBy])
}


model MeetingParticipant {
  id          String    @id @default(uuid())
  meetingId   String
  userId      String
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?
  duration    Int? // in seconds
  role        String    @default("participant") // host, co-host, participant
  handRaised  Boolean   @default(false)
  isMuted     Boolean   @default(false)
  isVideoOn   Boolean   @default(false)
  isSharing   Boolean   @default(false)

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([meetingId])
  @@index([userId])
}

// Time Tracking
model TimeEntry {
  id          String    @id @default(uuid())
  userId      String
  taskId      String?
  meetingId   String?
  description String?
  startTime   DateTime
  endTime     DateTime?
  duration    Int? // in seconds (calculated)
  billable    Boolean   @default(false)
  tags        String[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User  @relation(fields: [userId], references: [id])
  task Task? @relation(fields: [taskId], references: [id])

  @@index([userId])
  @@index([taskId])
  @@index([meetingId])
  @@index([startTime])
}

// Calendar & Reminders
model Reminder {
  id          String   @id @default(uuid())
  title       String
  description String?
  type        String // meeting, task, custom
  relatedId   String? // ID of related entity
  relatedType String? // meeting, task, etc.
  remindAt    DateTime
  isSent      Boolean  @default(false)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator    User                @relation("CreatedReminders", fields: [createdBy], references: [id])
  recipients ReminderRecipient[]

  @@index([remindAt])
  @@index([isSent])
  @@index([createdBy])
}

model ReminderRecipient {
  id         String    @id @default(uuid())
  reminderId String
  userId     String
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  reminder Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reminderId, userId])
  @@index([reminderId])
  @@index([userId])
}

// ============================================
// Daily Standups / Status Updates
// ============================================
// Shared Drive models

model DriveEntry {
  id        String   @id @default(uuid())
  name      String
  // Folder path relative to team, root = "/"
  path      String   @default("/")
  isFolder  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamId      String
  createdById String

  team      Team               @relation(fields: [teamId], references: [id])
  createdBy User               @relation(fields: [createdById], references: [id])
  versions  DriveFileVersion[]
  permissions DrivePermission[]
  recordings MeetingRecording[]

  @@index([teamId, path, name])
}

model DrivePermission {
  id         String   @id @default(uuid())
  entryId    String
  userId     String
  permission String   @default("view") // view, edit
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  entry DriveEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([entryId, userId])
  @@index([entryId])
  @@index([userId])
}

model DriveFileVersion {
  id         String   @id @default(uuid())
  version    Int
  storageKey String // physical file key in storage (e.g. MinIO object key or local filename)
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())

  entryId     String
  createdById String

  entry     DriveEntry @relation(fields: [entryId], references: [id])
  createdBy User       @relation(fields: [createdById], references: [id])

  @@unique([entryId, version])
  @@index([entryId])
}

// Performance tracking models

model WorkHours {
  id        String   @id @default(uuid())
  date      DateTime @default(now())
  hours     Float // Hours worked
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  teamId String?

  user User  @relation(fields: [userId], references: [id])
  team Team? @relation(fields: [teamId], references: [id])

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@index([teamId])
}

// Enhanced Task Management Models

model Sprint {
  id          String   @id @default(uuid())
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime
  goal        String?
  status      String   @default("planned") // planned, active, closed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teamId      String
  createdById String

  team      Team   @relation(fields: [teamId], references: [id])
  createdBy User   @relation("SprintCreator", fields: [createdById], references: [id])
  tasks     Task[]

  @@index([teamId])
  @@index([status])
}

model Epic {
  id          String   @id @default(uuid())
  name        String
  description String?
  color       String? // Hex color for visual identification
  status      String   @default("active") // active, completed, cancelled
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teamId      String
  createdById String

  team      Team   @relation(fields: [teamId], references: [id])
  createdBy User   @relation("EpicCreator", fields: [createdById], references: [id])
  tasks     Task[]

  @@index([teamId])
  @@index([status])
}

model Subtask {
  id          String   @id @default(uuid())
  title       String
  isCompleted Boolean  @default(false)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskAttachment {
  id        String   @id @default(uuid())
  name      String
  url       String // File URL or path
  mimeType  String?
  size      Int? // File size in bytes
  createdAt DateTime @default(now())

  taskId String
  userId String // User who uploaded

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([taskId])
}

model MeetingReminder {
  id            String   @id @default(uuid())
  meetingId     String
  userId        String
  minutesBefore Int // 5, 15, or 30 minutes before meeting
  sentAt        DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId, minutesBefore])
  @@index([meetingId])
  @@index([userId])
}

model Holiday {
  id          String   @id @default(uuid())
  name        String
  nameEn      String? // English name
  date        DateTime // The date of the holiday
  isRecurring Boolean  @default(true) // If true, repeats yearly
  type        String   @default("public") // public, bank, regional
  country     String   @default("TH") // Country code
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([date])
  @@index([organizationId])
  @@index([country])
}

// ============================================
// Workflow Automation
// ============================================
// แก้ปัญหา: งานซ้ำๆ, Context switching, Manual processes
// ใช้งานจริง: Auto-create tasks from PR, Auto-schedule meetings, Auto-assign work

model Workflow {
  id          String   @id @default(uuid())
  name        String
  description String?
  trigger     String // event type: pr_created, meeting_ended, task_completed, etc.
  conditions  Json? // Conditions to check
  actions     Json // Array of actions to execute
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teamId    String?
  createdBy String

  team    Team?         @relation(fields: [teamId], references: [id])
  creator User          @relation("WorkflowCreator", fields: [createdBy], references: [id])
  runs    WorkflowRun[]

  @@index([teamId])
  @@index([isActive])
  @@index([trigger])
}

model WorkflowRun {
  id          String    @id @default(uuid())
  status      String    @default("running") // running, completed, failed
  input       Json? // Input data
  output      Json? // Output/result
  error       String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  workflowId String
  userId     String?

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id])

  @@index([workflowId])
  @@index([status])
  @@index([startedAt])
}

// ============================================
// Analytics & Insights
// ============================================
// แก้ปัญหา: ไม่รู้ productivity, Meeting effectiveness, Team health
// ใช้งานจริง: Dashboard, Reports, Insights สำหรับ manager



// ============================================
// Knowledge Base / Wiki
// ============================================
model WikiArticle {
  id        String   @id @default(uuid())
  title     String
  content   String // Markdown
  category  String?
  tags      String[]
  isPublic  Boolean  @default(true)
  teamId    String?
  createdBy String
  version   Int      @default(1)
  viewCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team        Team?                @relation(fields: [teamId], references: [id])
  creator     User                 @relation("WikiCreator", fields: [createdBy], references: [id])
  versions    WikiArticleVersion[]
  comments    WikiComment[]

  @@index([teamId])
  @@index([createdBy])
  @@index([category])
  @@index([isPublic])
  @@index([createdAt])
}

model WikiArticleVersion {
  id         String   @id @default(uuid())
  articleId  String
  version    Int
  title      String
  content    String
  changeNote String?
  createdBy  String
  createdAt  DateTime @default(now())

  article WikiArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  creator User        @relation("WikiVersionCreator", fields: [createdBy], references: [id])

  @@unique([articleId, version])
  @@index([articleId])
}

model WikiComment {
  id        String   @id @default(uuid())
  articleId String
  content   String
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  article WikiArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  creator User        @relation("WikiCommentCreator", fields: [createdBy], references: [id])

  @@index([articleId])
  @@index([createdBy])
}



// ============================================
// Announcements
// ============================================
model Announcement {
  id          String    @id @default(uuid())
  title       String
  content     String // Rich text or Markdown
  priority    String    @default("normal") // urgent, high, normal, low
  targetType  String    @default("all") // all, team, role, user
  targetIds   String[] // Team IDs, Role names, or User IDs
  attachments Json? // Array of { url: string, name: string }
  createdBy   String
  expiresAt   DateTime?
  status      String    @default("active") // active, archived
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  creator User               @relation("AnnouncementCreator", fields: [createdBy], references: [id])
  reads   AnnouncementRead[]

  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([expiresAt])
}

model AnnouncementRead {
  id             String   @id @default(uuid())
  announcementId String
  userId         String
  readAt         DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation("AnnouncementReads", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
}

// ============================================
// Project Management (Jira-like)
// ============================================
model Project {
  id          String   @id @default(uuid())
  key         String   // Project key (e.g., "ABC", "PROJ")
  name        String
  description String?
  color       String? // Hex color for visual identification
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teamId String
  team   Team   @relation(fields: [teamId], references: [id])
  tasks  Task[]

  @@unique([teamId, key])
  @@index([teamId])
}

model Component {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teamId String
  team   Team   @relation(fields: [teamId], references: [id])
  tasks  Task[]

  @@unique([teamId, name])
  @@index([teamId])
}

model Version {
  id          String    @id @default(uuid())
  name        String
  description String?
  released    Boolean   @default(false)
  releaseDate DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  teamId String
  team   Team   @relation(fields: [teamId], references: [id])
  tasks  Task[]

  @@index([teamId])
  @@index([released])
}

// ============================================
// Task Watchers & Issue Linking
// ============================================


model TaskTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  title       String
  content     String?
  priority    String   @default("medium")
  issueType   String   @default("task")
  tags        String[]
  storyPoints Int?
  estimate    Float?
  teamId      String?
  projectId   String?
  componentId String?
  versionId   String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([createdById])
}

model TaskWatcher {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
}

model IssueLink {
  id        String   @id @default(uuid())
  type      String   // blocks, relates, duplicates, clones
  sourceId  String   // Source task ID
  targetId  String   // Target task ID
  createdAt DateTime @default(now())

  source Task @relation("SourceTask", fields: [sourceId], references: [id], onDelete: Cascade)
  target Task @relation("TargetTask", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, type])
  @@index([sourceId])
  @@index([targetId])
}

// ============================================
// Role Permissions
// ============================================
// Granular permission management per role per organization

model RolePermission {
  id             String   @id @default(uuid())
  organizationId String
  role           String   // org_owner, admin, manager, employee, member
  resource       String   // users, teams, meetings, tasks, channels, reports, drive, settings, audit, invites, announcements
  action         String   // view, create, edit, delete, manage
  allowed        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, role, resource, action])
  @@index([organizationId, role])
}

// ============================================
// Configurable Workflow Statuses
// ============================================
model TaskWorkflowStatus {
  id       String @id @default(uuid())
  name     String // Display name (e.g., "To Do")
  key      String // Machine key (e.g., "todo") — matches Task.status values
  color    String @default("#94a3b8") // Hex color for UI
  category String @default("todo") // todo | doing | done
  position Int    @default(0) // Sort order
  teamId   String? // null = global default
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team Team? @relation(fields: [teamId], references: [id])

  @@unique([teamId, key])
  @@index([teamId, position])
}
